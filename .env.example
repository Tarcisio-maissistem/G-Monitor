# Backend (HTTP + WS sob mesma porta)
NODE_ENV=development
PORT=6060
LOG_LEVEL=info

# Database — Supabase (Postgres gerenciado, decisao D12 em design.md).
# Use a connection string do "Connection Pooling" (Transaction, porta 6543) do
# Supabase — a conexao DIRETA (porta 5432, db.<ref>.supabase.co) so resolve em
# IPv6 e nao funciona de toda rede. `?pgbouncer=true` desliga prepared
# statements, exigido pelo Prisma quando roda via pooler. `connection_limit=15`
# (default do Prisma seria so 9) — sem folga, sync de backlog grande satura o
# pool e deixa login/dashboard lentos (achado no piloto 22/08; ver tambem
# SYNC_CONCURRENCY em agents/syncRoutes.ts).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15

# Necessario so para rodar `prisma migrate` de um ambiente sem conexao direta
# em Postgres (ex.: sandbox sem saida de rede na porta 5432/6543): aplica SQL
# via Management API HTTPS. Token pessoal em supabase.com/dashboard/account/tokens.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-in-prod-min-32-chars-______
JWT_REFRESH_SECRET=change-me-in-prod-min-32-chars-other
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost

# Agent
AGENT_TOKEN_SECRET=change-me-min-32-chars-for-agent-tokens

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=

# Email
RESEND_API_KEY=
MAIL_FROM=noreply@gmonitor.com.br

# CORS
CORS_ORIGIN=http://localhost:5173

# Observability
LOKI_URL=http://localhost:3100
