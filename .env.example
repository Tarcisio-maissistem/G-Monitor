# Backend (HTTP + WS sob mesma porta)
NODE_ENV=development
PORT=6060
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://gmonitor:gmonitor@localhost:5432/gmonitor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-in-prod-min-32-chars-______
JWT_REFRESH_SECRET=change-me-in-prod-min-32-chars-other
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost

# Agent
AGENT_TOKEN_SECRET=change-me-min-32-chars-for-agent-tokens

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=

# Email
RESEND_API_KEY=
MAIL_FROM=noreply@gmonitor.com.br

# CORS
CORS_ORIGIN=http://localhost:5173

# Observability
LOKI_URL=http://localhost:3100
