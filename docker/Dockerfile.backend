# Build do backend. Single-stage para evitar problemas com pnpm virtual store.
FROM node:20.19-alpine
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# Copia tudo do monorepo necessario para o build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/backend ./apps/backend
COPY packages ./packages

# Instala todas as deps (devDeps necessarios para tsc + prisma)
RUN pnpm install --frozen-lockfile

# Compila os pacotes em ordem de dependencia
RUN pnpm --filter @gmonitor/rpc-contracts build \
 && pnpm --filter @gmonitor/shared build \
 && pnpm --filter @gmonitor/backend exec prisma generate \
 && pnpm --filter @gmonitor/backend build

ENV NODE_ENV=production
ENV PATH="/app/node_modules/.pnpm/node_modules/.bin:${PATH}"
EXPOSE 6060
WORKDIR /app/apps/backend
CMD ["sh", "-c", "prisma migrate deploy && node dist/index.js"]
